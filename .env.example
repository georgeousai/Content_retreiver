TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional. Chat the bot uploads reel thumbnails to so Telegram mints a
# non-expiring file_id for each (the upload message is deleted right after).
# Use your own chat id with the bot. Unset means reels save without pictures.
TELEGRAM_THUMBNAIL_CHAT_ID=
