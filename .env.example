TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Which model writes tags, collections, summaries, rankings and compiled
# lists. Any OpenAI-compatible provider works — Groq, DeepSeek, Qwen,
# Together, Moonshot, Mistral, OpenAI. Only the key is required; the rest
# default to Groq's free tier.
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# Which model transcribes a reel's audio. Defaults to the same provider and
# key as above, since one provider commonly serves both.
# TRANSCRIPTION_BASE_URL=
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Which model reads a reel's frames for on-screen text. Optional: without a
# key, reels are still downloaded and transcribed and only on-screen text
# goes unread. Defaults to Google's OpenAI-compatibility endpoint.
VISION_API_KEY=
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_MODEL=gemini-2.5-flash
